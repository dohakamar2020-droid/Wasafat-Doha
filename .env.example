# انسخ الملف ده لـ .env.local وحط القيم الحقيقية — متكومتش .env.local أبدًا
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require&channel_binding=require"
# سر توقيع جلسات الدخول (أي نص طويل عشوائي)
AUTH_SECRET="change-me-long-random-string"
# بريد الأدمن اللي يقدر يستخدم لوحة الإدارة المرتبطة بقاعدة البيانات (اختياري)
ADMIN_EMAIL=""
# مفتاح YouTube Data API لتحديث المشاهدات من لوحة الإدارة (اختياري)
YOUTUBE_API_KEY=""
