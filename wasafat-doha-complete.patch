+  // Never cache auth, APIs, admin, kitchen, image uploads, RSC responses or private pages.
+  if (
+    u.pathname.startsWith("/api/") ||
+    req.headers.get("RSC") ||
+    u.searchParams.has("_rsc")
+  )
+    return;
+  if (req.mode === "navigate" && /^\/kitchen(?:\/|$)/.test(u.pathname)) {
+    e.respondWith(
