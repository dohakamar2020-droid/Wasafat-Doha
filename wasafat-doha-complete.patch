+          </div>
+          <details className="details-menu">
+            <summary>كل المقادير — ×{scale}</summary>
+            <ul>
+              {ingredients.map((i, n) => (
+                <li key={`${i.name}-${n}`}>
+                  {i.amount != null && i.unit
