+      <div className="grid">
+        {w.recipes.map((r) => (
+          <RecipeCard
+            key={r.slug}
+            r={r}
+            reason={r.detail?.successTips[0] || r.why}
+          />
+        ))}
+      </div>
+      <p className="results-note">
+        أرقام الانتشار مشاهدات يوتيوب وليست زيارات الموقع. آخر رصد للدفعة
+        الأولى: {CAPTURED_AT}؛ التحديثات التالية يظهر تاريخها في المصدر.
+      </p>
+    </div>
+  );
+}
