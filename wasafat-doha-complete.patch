+            await store(req, r);
+          return r;
+        })
+        .catch(
+          async () =>
+            (await caches.match(req)) || (await caches.match("/offline.html")),
+        ),
+    );
+    return;
+  }
+  if (
+    u.pathname.startsWith("/_next/static/") ||
+    ["/recipe-fallback.svg", "/icon.svg"].includes(u.pathname)
+  )
+    e.respondWith(
+      caches.match(req).then(
+        (hit) =>
+          hit ||
+          fetch(req).then(async (r) => {
+            await store(req, r);
+            return r;
+          }),
+      ),
+    );
 });
diff --git a/scripts/dev.mjs b/scripts/dev.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4a98af13f71dc6aed3ae038c4c56ced6f6b982a3
--- /dev/null
+++ b/scripts/dev.mjs
@@ -0,0 +1,29 @@
+import { createRequire } from "node:module";
+import { spawn } from "node:child_process";
+const require = createRequire(import.meta.url);
+let port = "3000",
+  host = "0.0.0.0";
+const args = process.argv.slice(2);
+for (let i = 0; i < args.length; i++) {
+  if (["--port", "-p"].includes(args[i])) port = args[++i];
+  else if (["--host", "--hostname", "-H"].includes(args[i])) host = args[++i];
+  else if (args[i] !== "--strictPort")
+    throw new Error(`Unsupported dev option: ${args[i]}`);
+}
+const child = spawn(
+  process.execPath,
+  [
+    require.resolve("next/dist/bin/next"),
+    "dev",
+    "--hostname",
+    host,
+    "--port",
+    port,
+  ],
+  { stdio: "inherit" },
+);
+for (const signal of ["SIGINT", "SIGTERM"])
+  process.on(signal, () => child.kill(signal));
+child.on("exit", (code) => {
+  process.exitCode = code || 0;
+});
diff --git a/scripts/grant-admin.ts b/scripts/grant-admin.ts
