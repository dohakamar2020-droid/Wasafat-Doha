+const CACHE = "wq-public-v3";
+const PUBLIC =
+  /^\/(?:$|discover$|pick$|ingredients$|same-ingredient$|weekly$|about$|collections(?:\/[^/]+)?$|creators(?:\/[^/]+)?$|meals(?:\/[^/]+)?$|recipes\/[^/]+(?:\/cook)?$)/;
+self.addEventListener("install", (e) => {
