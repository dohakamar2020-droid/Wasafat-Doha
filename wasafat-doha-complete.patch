+        return;
+      }
+      wake.current = await navigator.wakeLock.request("screen");
+      wake.current.addEventListener("release", () => setAwake(false));
+      setAwake(true);
+    } catch {
+      setMessage("تعذّر إبقاء الشاشة صاحية. جرّب والمتصفح مفتوح قدامك.");
+    }
+  };
+  const next = (n: number) => {
